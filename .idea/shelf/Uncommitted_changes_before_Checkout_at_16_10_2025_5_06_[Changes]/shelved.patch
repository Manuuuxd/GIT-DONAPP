 Si es un invitado, no necesitamos revisar el token del admin\r\n    if (isGuest) {\r\n      if (mounted) setState(() => _isAdmin = false);\r\n      return;\r\n    }\r\n\r\n    // Si no es invitado, revisamos el token como antes\r\n    final prefs = await SharedPreferences.getInstance();\r\n    final token = prefs.getString('authToken');\r\n\r\n    if (token != null && !JwtDecoder.isExpired(token)) {\r\n      final decoded = JwtDecoder.decode(token);\r\n      final isAdmin = decoded['is_admin'] == true;\r\n      if (mounted) setState(() => _isAdmin = isAdmin);\r\n    } else {\r\n      if (mounted) setState(() => _isAdmin = false);\r\n    }\r\n  }\r\n\r\n  void _enableAdminSecret() {\r\n    if (!kDebugMode) return;\r\n    if (mounted) {\r\n      setState(() => _isAdmin = true);\r\n      ScaffoldMessenger.of(context).showSnackBar(\r\n        const SnackBar(content: Text('\uD83D\uDD13 Modo admin activado (debug)')),\r\n      );\r\n    }\r\n  }\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Scaffold(\r\n      backgroundColor: AppColors.background,\r\n      body: SafeArea(\r\n        child: SingleChildScrollView(\r\n          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 16),\r\n          child: Column(\r\n            crossAxisAlignment: CrossAxisAlignment.start,\r\n            children: [\r\n              _CustomAppBar(onSecretAdmin: _enableAdminSecret, isGuest: _isGuestUser),\r\n              const SizedBox(height: 16),\r\n\r\n              // 4. OCULTAR GAMIFICACIÓN SI ES INVITADO (Criterio CA04)\r\n              if (!_isGuestUser)\r\n                FutureBuilder(\r\n                  future: Future.wait([Gamification.xp(), Gamification.streak()]),\r\n                  builder: (context, snap) {\r\n                    if (snap.connectionState != ConnectionState.done || !snap.hasData) {\r\n                      return const SizedBox.shrink();\r\n                    }\r\n                    final xp = (snap.data as List)[0] as int;\r\n                    final streak = (snap.data as List)[1] as int;\r\n                    return Row(\r\n                      children: [\r\n                        XpPill(xp: xp),\r\n                        const SizedBox(width: 8),\r\n                        StreakPill(days: streak),\r\n                      ],\r\n                    );\r\n                  },\r\n                ),\r\n              \r\n              if (!_isGuestUser) const SizedBox(height: 12),\r\n\r\n              // Las siguientes acciones están disponibles para todos los usuarios\r\n              _ActionTile(\r\n                icon: Icons.quiz_rounded,\r\n                label: 'Trivia',\r\n                onTap: () => Navigator.push(context, MaterialPageRoute(builder: (_) => const NivelIntroScreen())),\r\n              ),\r\n              const SizedBox(height: 10),\r\n\r\n              // Los desafíos requieren cuenta\r\n              if (!_isGuestUser)\r\n                _ActionTile(\r\n                  icon: Icons.military_tech_rounded,\r\n                  label: 'Desafíos Semanales',\r\n                  onTap: () => Navigator.push(context, MaterialPageRoute(builder: (_) => const DesafiosScreen())),\r\n                ),\r\n              \r\n              if (!_isGuestUser) const SizedBox(height: 10),\r\n              \r\n              const _HeaderCardBlue(), // Saludo genérico que funciona para ambos\r\n              const SizedBox(height: 20),\r\n\r\n              const _SectionTitleBlue('Tu actividad'),\r\n              const SizedBox(height: 10),\r\n\r\n              // 5. DESHABILITAR/OCULTAR BOTONES QUE REQUIEREN CUENTA\r\n              if (!_isGuestUser)\r\n                _ActionTile(\r\n                  icon: Icons.emoji_events_rounded,\r\n                  label: 'Mis logros',\r\n                  onTap: () => Navigator.push(context, MaterialPageRoute(builder: (_) => const LogrosScreen())),\r\n                ),\r\n              if (!_isGuestUser) const SizedBox(height: 10),\r\n\r\n              if (!_isGuestUser)\r\n                _ActionTile(\r\n                  icon: Icons.share_rounded,\r\n                  label: 'Comparte tus logros',\r\n                  onTap: () => Navigator.push(context, MaterialPageRoute(builder: (_) => const ShareScreen())),\r\n                ),\r\n              if (!_isGuestUser) const SizedBox(height: 10),\r\n\r\n              // Acciones disponibles para todos\r\n              _ActionsGrid(items: [\r\n                _ActionItem(\r\n                  label: 'Agendar',\r\n                  icon: Icons.schedule_rounded,\r\n                  onTap: (ctx) => Navigator.push(ctx, MaterialPageRoute(builder: (_) => const ScheduleScreen())),\r\n                ),\r\n                _ActionItem(\r\n                  icon: Icons.list_alt_rounded,\r\n                  label: 'Listado Campañas',\r\n                  onTap: (ctx) => Navigator.push(ctx, MaterialPageRoute(builder: (_) => const CampaniasScreen())),\r\n                ),\r\n              ]),\r\n              const SizedBox(height: 10),\r\n              _ActionTile(\r\n                icon: Icons.map_rounded,\r\n                label: 'Mapa',\r\n                onTap: () => Navigator.push(context, MaterialPageRoute(builder: (_) => const MapScreen())),\r\n              ),\r\n\r\n              const SizedBox(height: 20),\r\n              const _SectionTitleBlue('Juegos & aprendizaje'),\r\n              const SizedBox(height: 10),\r\n\r\n              // Estos juegos están disponibles para invitados (CA04)\r\n              _ActionsGrid(items: [\r\n                _ActionItem(\r\n                  icon: Icons.auto_stories_rounded,\r\n                  label: 'Historias',\r\n                  onTap: (ctx) => Navigator.push(ctx, MaterialPageRoute(builder: (_) => const HistoriasScreen())),\r\n                ),\r\n                _ActionItem(\r\n                  icon: Icons.videogame_asset_rounded,\r\n                  label: 'Match',\r\n                  onTap: (ctx) => Navigator.push(ctx, MaterialPageRoute(builder: (_) => const BloodCompatibilityApp())),\r\n                ),\r\n                _ActionItem(\r\n                  icon: Icons.sports_esports_rounded,\r\n                  label: 'Simulador',\r\n                  onTap: (ctx) => Navigator.push(ctx, MaterialPageRoute(builder: (_) => const JennyGamePage())),\r\n                ),\r\n              ]),\r\n              \r\n              if (_isAdmin) ...[\r\n                const SizedBox(height: 20),\r\n                const _SectionTitleBlue('Panel de Administrador'),\r\n                const SizedBox(height: 10),\r\n                _ActionTile(\r\n                  icon: Icons.add_circle_rounded,\r\n                  label: 'Crear Campaña',\r\n                  onTap: () async {\r\n                    final prefs = await SharedPreferences.getInstance();\r\n                    final jwtToken = prefs.getString('authToken');\r\n                    if(mounted && jwtToken != null) {\r\n                      Navigator.push(context, MaterialPageRoute(builder: (_) => CrearCampaniaScreen(jwtToken: jwtToken)));\r\n                    }\r\n                  }\r\n                )\r\n              ]\r\n            ],\r\n          ),\r\n        ),\r\n      ),\r\n    );\r\n  }\r\n}\r\n\r\n// 6. MODIFICAR EL APPBAR PARA MOSTRAR UN ESTADO DE INVITADO\r\nclass _CustomAppBar extends StatefulWidget {\r\n  final VoidCallback onSecretAdmin;\r\n  final bool isGuest;\r\n  const _CustomAppBar({required this.onSecretAdmin, required this.isGuest});\r\n\r\n  @override\r\n  State<_CustomAppBar> createState() => _CustomAppBarState();\r\n}\r\n\r\nclass _CustomAppBarState extends State<_CustomAppBar> {\r\n  int _tapCount = 0;\r\n  Timer? _tapTimer;\r\n\r\n  void _onLogoTap() {\r\n    _tapCount++;\r\n    _tapTimer?.cancel();\r\n    _tapTimer = Timer(const Duration(milliseconds: 500), () => _tapCount = 0);\r\n\r\n    if (_tapCount >= 3) {\r\n      _tapCount = 0;\r\n      _tapTimer?.cancel();\r\n      widget.onSecretAdmin();\r\n    }\r\n  }\r\n\r\n  @override\r\n  void dispose() {\r\n    _tapTimer?.cancel();\r\n    super.dispose();\r\n  }\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Padding(\r\n      padding: const EdgeInsets.only(top: 6.0),\r\n      child: Row(\r\n        mainAxisAlignment: MainAxisAlignment.spaceBetween,\r\n        children: [\r\n          Row(\r\n            children: [\r\n              GestureDetector(\r\n                onTap: _onLogoTap,\r\n                child: Container(\r\n                  width: 40,\r\n                  height: 40,\r\n                  clipBehavior: Clip.antiAlias,\r\n                  decoration: BoxDecoration(\r\n                    shape: BoxShape.circle,\r\n                    color: AppColors.surface,\r\n                    boxShadow: [BoxShadow(blurRadius: 8, offset: const Offset(0, 4), color: Colors.black.withOpacity(0.06))],\r\n                  ),\r\n                  child: Image.asset('assets/images/icon.png', fit: BoxFit.cover),\r\n                ),\r\n              ),\r\n              const SizedBox(width: 8),\r\n              const Text('Donapp', style: TextStyle(fontSize: 20, fontWeight: FontWeight.w800, color: AppColors.onBackground, letterSpacing: .3)),\r\n            ],\r\n          ),\r\n          // Mostrar avatar o un botón de \"Acceder\"\r\n          widget.isGuest\r\n              ? OutlinedButton(\r\n                  onPressed: () {\r\n                    SessionManager.clearSession();\r\n                    Navigator.pushReplacementNamed(context, '/login');\r\n                  },\r\n                  style: OutlinedButton.styleFrom(\r\n                    foregroundColor: AppColors.primary,\r\n                    side: BorderSide(color: AppColors.primary),\r\n                  ),\r\n                  child: const Text('Acceder'),\r\n                )\r\n              : Row(\r\n                  children: [\r\n                    Text('Donante Pro', style: TextStyle(color: AppColors.customBlue[800], fontWeight: FontWeight.w700)),\r\n                    const SizedBox(width: 8),\r\n                    const CircleAvatar(backgroundImage: AssetImage('assets/images/avatar3.png'), radius: 16),\r\n                  ],\r\n                ),\r\n        ],\r\n      ),\r\n    );\r\n  }\r\n}\r\n\r\n// El resto de tus widgets de UI (_HeaderCardBlue, _ActionTile, etc.) no necesitan cambios.\r\n// Solo los pego abajo para que el archivo esté completo.\r\n\r\nclass _HeaderCardBlue extends StatelessWidget {\r\n  const _HeaderCardBlue();\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Container(\r\n      padding: const EdgeInsets.all(14.0),\r\n      decoration: BoxDecoration(\r\n        color: AppColors.customBlue[50],\r\n        borderRadius: BorderRadius.circular(14.0),\r\n        border: Border.all(color: AppColors.borderOutline),\r\n      ),\r\n      child: Row(\r\n        children: [\r\n          Image.asset('assets/images/blood_drop_character.png', width: 64, height: 64),\r\n          const SizedBox(width: 12),\r\n          const Expanded(\r\n            child: Column(\r\n              crossAxisAlignment: CrossAxisAlignment.start,\r\n              children: [\r\n                Text('¡Hola Donante!', style: TextStyle(fontSize: 18, fontWeight: FontWeight.w800, color: AppColors.onBackground)),\r\n                SizedBox(height: 4),\r\n                Text('Elige qué deseas hacer:', style: TextStyle(fontSize: 14, color: AppColors.textMuted)),\r\n              ],\r\n            ),\r\n          ),\r\n        ],\r\n      ),\r\n    );\r\n  }\r\n}\r\n\r\nclass _SectionTitleBlue extends StatelessWidget {\r\n  final String text;\r\n  const _SectionTitleBlue(this.text);\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Text(\r\n      text,\r\n      style: TextStyle(color: AppColors.customBlue[700], fontWeight: FontWeight.w800, fontSize: 15, letterSpacing: .2),\r\n    );\r\n  }\r\n}\r\n\r\nclass _ActionItem {\r\n  final IconData icon;\r\n  final String label;\r\n  final void Function(BuildContext) onTap;\r\n  _ActionItem({required this.icon, required this.label, required this.onTap});\r\n}\r\n\r\nclass _ActionsGrid extends StatelessWidget {\r\n  final List<_ActionItem> items;\r\n  const _ActionsGrid({required this.items});\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return GridView.builder(\r\n      shrinkWrap: true,\r\n      physics: const NeverScrollableScrollPhysics(),\r\n      itemCount: items.length,\r\n      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(\r\n        crossAxisCount: 2,\r\n        mainAxisSpacing: 12,\r\n        crossAxisSpacing: 12,\r\n        childAspectRatio: 2.8,\r\n      ),\r\n      itemBuilder: (ctx, i) {\r\n        final it = items[i];\r\n        return _ActionTile(icon: it.icon, label: it.label, onTap: () => it.onTap(ctx));\r\n      },\r\n    );\r\n  }\r\n}\r\n\r\nclass _ActionTile extends StatelessWidget {\r\n  final IconData icon;\r\n  final String label;\r\n  final VoidCallback onTap;\r\n\r\n  const _ActionTile({required this.icon, required this.label, required this.onTap});\r\n\r\n  @override\r\n  Widget build(BuildContext context) {\r\n    return Material(\r\n      color: AppColors.surface,\r\n      borderRadius: BorderRadius.circular(12),\r\n      child: InkWell(\r\n        onTap: onTap,\r\n        borderRadius: BorderRadius.circular(12),\r\n        child: Container(\r\n          decoration: BoxDecoration(\r\n            color: AppColors.surface,\r\n            borderRadius: BorderRadius.circular(12),\r\n            border: Border.all(color: AppColors.borderOutline),\r\n            boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.06), blurRadius: 6, offset: const Offset(0, 4))],\r\n          ),\r\n          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),\r\n          child: Row(\r\n            children: [\r\n              Container(\r\n                padding: const EdgeInsets.all(8),\r\n                decoration: BoxDecoration(color: AppColors.customBlue[50], borderRadius: BorderRadius.circular(10)),\r\n                child: Icon(icon, color: AppColors.customBlue[700], size: 20),\r\n              ),\r\n              const SizedBox(width: 10),\r\n              Expanded(\r\n                child: Text(\r\n                  label,\r\n                  maxLines: 1,\r\n                  overflow: TextOverflow.ellipsis,\r\n                  style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w700, color: AppColors.onBackground),\r\n                ),\r\n              ),\r\n              Icon(Icons.chevron_right_rounded, color: AppColors.customBlue[700], size: 20),\r\n            ],\r\n          ),\r\n        ),\r\n      ),\r\n    );\r\n  }\r\n}
